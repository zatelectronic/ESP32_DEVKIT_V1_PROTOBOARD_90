	(text "NOTES"
		(exclude_from_sim no)
		(at 81.026 166.624 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.3048)
				(bold yes)
				(color 30 40 48 1)
			)
			(justify left)
		)
		(uuid "690e94d7-7aaa-4711-b225-0936fe5b3f7c")
	)
	(text "1. U1 = DOIT ESP32 DevKit V1, 30 pins (ESP32-WROOM-32), plugged into two 1x15 female headers 25.4 mm apart."
		(exclude_from_sim no)
		(at 81.026 169.672 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "d47a3436-3465-417b-ac6d-e1e502a06ad0")
	)
	(text "2. Every DevKit pin goes to a global label with the same name used on J1 (page 03). Both GND pins (2 and 29) tied together."
		(exclude_from_sim no)
		(at 81.026 172.466 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "062e3d6f-416c-4c50-8fd4-55bfd624b33e")
	)
	(text "3. GPIO34, 35, 36 (VP) and 39 (VN) are input only. ADC2 pins cannot be read while Wi-Fi is on."
		(exclude_from_sim no)
		(at 81.026 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "ebc3957a-060f-4858-8a2f-a36a9a2b7ffe")
	)
	(text "4. Boot strapping: GPIO2, GPIO5, GPIO12 and GPIO15 - keep GPIO12 LOW at power-up (3.3 V flash)."
		(exclude_from_sim no)
		(at 81.026 178.054 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "21a1dc1b-f990-4242-bb35-df57ee00e852")
	)
	(text "5. PWR_FLAG on 3V3, VIN and GND is on page 03 (connector side)."
		(exclude_from_sim no)
		(at 81.026 180.848 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "62626842-2506-4566-ad46-aa50f6daebf1")
	)
