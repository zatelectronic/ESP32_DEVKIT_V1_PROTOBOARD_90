	(text "NOTES"
		(exclude_from_sim no)
		(at 136.906 195.834 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.3048)
				(bold yes)
				(color 30 40 48 1)
			)
			(justify left)
		)
		(uuid "c2ec84f2-3f1c-45db-b961-7972234c320a")
	)
	(text "1. J1 = 1x30 right-angle header on the board edge: pin n = DevKit pin n (1 ... 30), left to right seen from the top."
		(exclude_from_sim no)
		(at 136.906 198.882 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "391b2f6b-43e5-4557-91da-d41b3a0ea54c")
	)
	(text "2. The board stands vertical on the breadboard: each pin uses its own breadboard row (30 rows, 76.2 mm)."
		(exclude_from_sim no)
		(at 136.906 201.676 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "b7345b21-d840-4676-ac38-4d3f74c7961e")
	)
	(text "3. Power: 3V3 = pin 1, VIN (5 V) = pin 30, GND = pins 2 and 29. No protection: 3.3 V logic straight from the ESP32."
		(exclude_from_sim no)
		(at 136.906 204.47 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 60 68 74 1)
			)
			(justify left)
		)
		(uuid "f17d288c-5f4a-4a6b-b924-5d4b4c55831c")
	)
	(rectangle
		(start 128.27 66.04)
